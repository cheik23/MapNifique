# Laisser vide en développement local : Vite passe /api vers le scraper sur :8787.
# Pour un déploiement, renseigner l'origine HTTPS publique de l'API (valeur publique, sans secret).
VITE_MAPNIFIQUE_API_URL=

# Optionnel : laisser vide pour le moteur de carte par défaut.
VITE_MAPNIFIQUE_MAP_ENGINE=
VITE_MAPNIFIQUE_PMTILES_URL=
